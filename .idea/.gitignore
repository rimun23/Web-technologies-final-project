 const $charCounter = $(`
    <div class="d-flex justify-content-between mt-1">
        <small class="counter-text text-muted">Символов: <span class="char-num">0</span> (мин. 5)</small>
    </div>
`);
    $('#reviewText').after($charCounter);
    $('#reviewText').on('input', function () {
        const len = $(this).val().trim().length;
        const $num = $charCounter.find('.char-num');

        $num.text(len);

        if (len >= 5) {
            $charCounter.find('.counter-text')
                .removeClass('text-danger text-muted')
                .addClass('text-success');
        } else {
            $charCounter.find('.counter-text')
                .removeClass('text-success text-muted')
                .addClass('text-danger');
        }
    });





